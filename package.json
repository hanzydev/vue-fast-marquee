    "devDependencies": {
        "@types/node": "^26.2.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "prettier": "^3.9.6",
        "sass": "^1.103.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^5.0.3",
        "vue": "^3.5.41",
